    {
      "name": "1. Registro, login, current y logout",
      "item": [
        {
          "name": "Registro (role en el body se ignora)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newEmail\", \"nuevo\" + Date.now() + \"@test.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"La respuesta no contiene password\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));",
                  "pm.test(\"Role user por defecto\", () => pm.expect(pm.response.json().payload.role).to.eql(\"user\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Pérez\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"secret123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/register",
              "host": [
                "{{baseUrl}}"
